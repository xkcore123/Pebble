+/// Stream identity lookup results through the matching tagged completion. The
+/// high-level search/fetch streams in async-imap 0.10 hide tagged failures.
+async fn identity_command(
+    sess: &mut ImapSession,
+    command: &str,
+    mut receive: impl FnMut(&async_imap::imap_proto::Response<'_>),
+) -> async_imap::error::Result<()> {
+    use async_imap::error::Error;
+    use async_imap::imap_proto::{Response, Status};
+    let tag = sess.run_command(command).await?;
+    loop {
+        let response = sess.read_response().await.ok_or(Error::ConnectionLost)??;
+        match response.parsed() {
+            Response::Done {
+                tag: done,
+                status,
+                information,
+                ..
+            } if *done == tag => {
+                let details = || information.as_deref().unwrap_or("No details").to_owned();
+                return match status {
+                    Status::Ok => Ok(()),
+                    Status::Bad => Err(Error::Bad(details())),
+                    _ => Err(Error::No(details())),
+                };
+            }
+            Response::Data {
+                status: Status::Bye,
+                ..
+            } => return Err(Error::ConnectionLost),
+            data => receive(data),
+        }
+    }
+}
+
+async fn checked_uid_search(
+    sess: &mut ImapSession,
+    criteria: &str,
+) -> async_imap::error::Result<Vec<u32>> {
+    use async_imap::imap_proto::{MailboxDatum, Response};
+    let mut hits = None;
+    identity_command(sess, &format!("UID SEARCH {criteria}"), |data| {
+        if let Response::MailboxData(MailboxDatum::Search(ids)) = data {
+            hits.get_or_insert_with(Vec::new).extend_from_slice(ids);
+        }
+    })
+    .await?;
+    hits.ok_or_else(|| {
+        async_imap::error::Error::Parse(async_imap::error::ParseError::ExpectedResponseNotFound(
+            "SEARCH".into(),
+        ))
+    })
+}
