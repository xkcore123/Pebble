+        progress.push(event);
+    }
+    assert_eq!(
+        progress
+            .iter()
+            .map(|event| event.status.as_str())
+            .collect::<Vec<_>>(),
+        ["started", "completed"]
+    );
+    assert!(progress.iter().all(|event| event.phase == "reconcile"));
