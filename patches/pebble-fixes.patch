+#[tokio::test]
+async fn rejected_or_truncated_uid_inventory_never_deletes_cached_mail() {
+    use crate::test_imap::{Behavior, Server};
+    for behavior in [
+        Behavior::SearchDenied,
+        Behavior::SearchBad,
+        Behavior::SearchDropped,
+        Behavior::EmptySearch,
+    ] {
+        let server = Server::start(behavior).await;
+        let provider = Arc::new(ImapMailProvider::new(server.config()));
+        provider.connect().await.unwrap();
+        let store = test_store_with_message("retained");
+        store.update_remote_id("retained", "7").unwrap();
+        let folder = store.list_folders("account-1").unwrap().remove(0);
+        let (_stop_tx, stop_rx) = watch::channel(false);
+        let worker = SyncWorker::new(
+            "account-1",
+            provider,
+            Arc::clone(&store),
+            stop_rx,
+            std::env::temp_dir(),
+        );
+        let result = worker.reconcile_folder_once(&folder).await;
+        if matches!(behavior, Behavior::EmptySearch) {
+            result.unwrap();
+            assert!(store.get_message("retained").unwrap().unwrap().is_deleted);
+        } else {
+            assert!(
+                server.command_count("UID SEARCH") > 0,
+                "failure injection must reach SEARCH"
+            );
+            assert!(result.is_err(), "Failed inventory must stop reconciliation");
+            assert!(!store.get_message("retained").unwrap().unwrap().is_deleted);
+        }
+    }
+}
