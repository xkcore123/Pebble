+fn move_merges_concurrent_destination_cache_and_preserves_references() {
+    let store = Store::open_in_memory().unwrap();
+    let account = make_account();
+    let inbox = make_folder(&account.id, "INBOX", FolderRole::Inbox, 0);
+    let trash = make_folder(&account.id, "Trash", FolderRole::Trash, 1);
+    store.insert_account(&account).unwrap();
+    store.insert_folder(&inbox).unwrap();
+    store.insert_folder(&trash).unwrap();
+    let mut original = make_message(&account.id, "5");
+    original.message_id_header = Some("<same@example.invalid>".into());
+    original.body_text.clear();
+    let mut cached = make_message(&account.id, "42");
+    cached.message_id_header = original.message_id_header.clone();
+    cached.body_text = "body fetched by concurrent sync".into();
+    store
+        .insert_message(&original, std::slice::from_ref(&inbox.id))
+        .unwrap();
+    store
+        .insert_message(&cached, std::slice::from_ref(&trash.id))
+        .unwrap();
+    store
+        .insert_attachment(&Attachment {
+            id: "cached-file".into(),
+            message_id: cached.id.clone(),
+            filename: "file.txt".into(),
+            mime_type: "text/plain".into(),
+            size: 1,
+            local_path: None,
+            content_id: None,
+            is_inline: false,
+        })
+        .unwrap();
+    store
+        .insert_pending_mail_op(&account.id, &cached.id, "update_flags", "{}")
+        .unwrap();
+    store.soft_delete_message(&original.id).unwrap();
+    store
+        .move_message_to_folder_with_remote_id(&original.id, &trash.id, "42")
+        .unwrap();
+    assert!(store.get_message(&cached.id).unwrap().is_none());
+    let moved = store.get_message(&original.id).unwrap().unwrap();
+    assert_eq!(moved.remote_id, "42");
+    assert_eq!(moved.body_text, "body fetched by concurrent sync");
+    assert!(!moved.is_deleted);
+    assert_eq!(
+        store.get_message_folder_ids(&original.id).unwrap(),
