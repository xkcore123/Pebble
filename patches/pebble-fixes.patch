+//! OAuth configuration policy shared by sign-in and token refresh.
+//! The standalone test also compiles this exact source with debug assertions off.
+
+pub(crate) fn dotenv_lookup_from_str(contents: &str, key: &str) -> Option<String> {
+    for raw_line in contents.lines() {
+        let line = raw_line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+
+        let Some((name, value)) = line.split_once('=') else {
+            continue;
+        };
+        if name.trim() != key {
+            continue;
+        }
+
+        let value = value.trim();
+        let unquoted = value
+            .strip_prefix('"')
+            .and_then(|v| v.strip_suffix('"'))
+            .or_else(|| value.strip_prefix('\'').and_then(|v| v.strip_suffix('\'')))
+            .unwrap_or(value);
+        return Some(unquoted.to_string());
+    }
+    None
+}
+
+/// The installed configuration is anchored to the executable, never the launch
+/// directory. Release builds deliberately exclude development search paths.
+fn dotenv_candidate_paths(
+    executable: Option<&std::path::Path>,
+    current_dir: Option<&std::path::Path>,
+    manifest_dir: &std::path::Path,
+    development: bool,
+) -> Vec<std::path::PathBuf> {
+    let mut candidates = Vec::new();
+    if let Some(parent) = executable.and_then(std::path::Path::parent) {
+        if parent.is_absolute() {
+            candidates.push(parent.join(".env"));
+        }
+    }
+    if development {
+        if let Some(current_dir) = current_dir {
+            candidates.push(current_dir.join(".env"));
+            candidates.push(current_dir.join("..").join(".env"));
+        }
+        candidates.push(manifest_dir.join(".env"));
+        candidates.push(manifest_dir.join("..").join(".env"));
+    }
+    candidates
+}
+
+fn dotenv_contents_from_paths(candidates: Vec<std::path::PathBuf>) -> Option<String> {
+    candidates
+        .into_iter()
+        .find_map(|path| std::fs::read_to_string(path).ok())
+}
+
+pub(crate) fn dotenv_contents() -> Option<String> {
+    let executable = std::env::current_exe().ok();
+    let current_dir = if cfg!(debug_assertions) {
+        std::env::current_dir().ok()
+    } else {
+        None
+    };
+    dotenv_contents_from_paths(dotenv_candidate_paths(
+        executable.as_deref(),
+        current_dir.as_deref(),
+        std::path::Path::new(env!("CARGO_MANIFEST_DIR")),
+        cfg!(debug_assertions),
+    ))
+}
+
+pub(crate) fn oauth_config_value_from_sources(
+    key: &str,
+    env_value: Option<&str>,
+    dotenv_contents: Option<&str>,
+    compile_value: Option<&str>,
+    placeholder: &str,
+) -> String {
+    env_value
+        .filter(|value| !is_placeholder(value))
+        .map(ToOwned::to_owned)
+        .or_else(|| {
+            dotenv_contents
+                .and_then(|contents| dotenv_lookup_from_str(contents, key))
+                .filter(|value| !is_placeholder(value))
+        })
+        .or_else(|| {
+            compile_value
+                .filter(|value| !is_placeholder(value))
+                .map(ToOwned::to_owned)
+        })
+        .unwrap_or_else(|| placeholder.to_string())
+}
+
+pub(crate) fn oauth_config_value(
+    key: &str,
+    compile_value: Option<&str>,
+    placeholder: &str,
+) -> String {
+    // Runtime environment overrides are likewise limited to debug builds;
+    // release builds use the installed file or values fixed at compile time.
+    let env_value = if cfg!(debug_assertions) {
+        std::env::var(key).ok()
+    } else {
+        None
+    };
+    let dotenv = dotenv_contents();
+    oauth_config_value_from_sources(
+        key,
+        env_value.as_deref(),
+        dotenv.as_deref(),
+        compile_value,
+        placeholder,
+    )
+}
+
+pub(crate) fn is_placeholder(value: &str) -> bool {
+    let v = value.trim();
+    v.is_empty()
+        || v.eq_ignore_ascii_case("YOUR_CLIENT_ID")
+        || v.eq_ignore_ascii_case("YOUR_CLIENT_SECRET")
+        || v.ends_with("_PLACEHOLDER")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn release_dotenv_only_uses_absolute_executable_directory() {
+        let root = std::env::temp_dir().join("pebble-oauth-paths");
+        let exe = root.join("installed").join("pebble.exe");
+        let cwd = root.join("untrusted");
+        let manifest = root.join("checkout").join("src-tauri");
+        assert_eq!(
+            dotenv_candidate_paths(Some(&exe), Some(&cwd), &manifest, false),
+            vec![root.join("installed").join(".env")]
+        );
+        assert!(dotenv_candidate_paths(None, Some(&cwd), &manifest, false).is_empty());
+        assert!(dotenv_candidate_paths(
+            Some(std::path::Path::new("pebble.exe")),
+            Some(&cwd),
+            &manifest,
+            false
+        )
+        .is_empty());
+    }
+
+    #[test]
+    fn release_dotenv_does_not_fall_back_to_working_directory_when_install_file_missing() {
+        let root = std::env::temp_dir().join(format!("pebble-oauth-{}", std::process::id()));
+        let install = root.join("installed");
+        let untrusted = root.join("untrusted");
+        std::fs::create_dir_all(&install).unwrap();
+        std::fs::create_dir_all(&untrusted).unwrap();
+        std::fs::write(untrusted.join(".env"), "GOOGLE_CLIENT_ID=untrusted-client").unwrap();
+        let paths = dotenv_candidate_paths(
+            Some(&install.join("pebble.exe")),
+            Some(&untrusted),
+            &untrusted,
+            false,
+        );
+        assert_eq!(dotenv_contents_from_paths(paths.clone()), None);
+        std::fs::write(install.join(".env"), "GOOGLE_CLIENT_ID=installed-client").unwrap();
+        assert_eq!(
+            dotenv_contents_from_paths(paths).as_deref(),
+            Some("GOOGLE_CLIENT_ID=installed-client")
+        );
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[test]
+    fn debug_dotenv_keeps_development_fallbacks_after_install_path() {
+        let root = std::env::temp_dir().join("pebble-oauth-dev-paths");
+        let exe = root.join("installed").join("pebble.exe");
+        let cwd = root.join("checkout");
+        let manifest = cwd.join("src-tauri");
+        let paths = dotenv_candidate_paths(Some(&exe), Some(&cwd), &manifest, true);
+        assert_eq!(paths[0], root.join("installed").join(".env"));
+        assert_eq!(paths[1], cwd.join(".env"));
+        assert!(paths.contains(&manifest.join(".env")));
+    }
+
+    #[test]
+    fn effective_build_mode_controls_process_override_and_install_file_lookup() {
+        let key = "PEBBLE_OAUTH_RUNTIME_TEST_CLIENT";
+        std::env::set_var(key, "injected-process-client");
+        // A unique key avoids relying on any developer's real .env configuration.
+        let actual = oauth_config_value(key, Some("compiled-client"), "missing");
+        assert_eq!(
+            actual,
+            if cfg!(debug_assertions) {
+                "injected-process-client"
+            } else {
+                "compiled-client"
+            }
+        );
+        std::env::remove_var(key);
+    }
+
+    #[test]
+    fn installed_google_and_microsoft_values_and_optional_secrets_are_read() {
+        let contents = "GOOGLE_CLIENT_ID=google-test\nGOOGLE_CLIENT_SECRET=google-secret\nMICROSOFT_CLIENT_ID=microsoft-test\nMICROSOFT_CLIENT_SECRET=microsoft-secret";
+        for (key, expected) in [
+            ("GOOGLE_CLIENT_ID", "google-test"),
+            ("GOOGLE_CLIENT_SECRET", "google-secret"),
+            ("MICROSOFT_CLIENT_ID", "microsoft-test"),
+            ("MICROSOFT_CLIENT_SECRET", "microsoft-secret"),
+        ] {
+            assert_eq!(
+                oauth_config_value_from_sources(key, None, Some(contents), None, "missing"),
+                expected
+            );
+        }
+        assert_eq!(
+            oauth_config_value_from_sources(
+                "GOOGLE_CLIENT_ID",
+                None,
+                Some("GOOGLE_CLIENT_ID=YOUR_CLIENT_ID"),
+                Some("compiled-client"),
+                "missing"
+            ),
+            "compiled-client"
+        );
+    }
+}
