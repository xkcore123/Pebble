+#[tokio::test]
+async fn manual_full_failure_retries_before_normal_reconcile_interval() {
+    let server = crate::test_imap::Server::start(crate::test_imap::Behavior::ArmedBye).await;
+    let provider = Arc::new(ImapMailProvider::new(server.config()));
+    let (stop_tx, stop_rx) = watch::channel(false);
+    let (progress_tx, mut progress_rx) = mpsc::unbounded_channel();
+    let (trigger_tx, trigger_rx) = mpsc::unbounded_channel();
+    let worker = SyncWorker::new(
+        "account-1",
+        provider,
+        test_store_with_message("manual-recovery"),
+        stop_rx,
+        std::env::temp_dir(),
+    )
+    .with_progress_tx(progress_tx);
+    let task = tokio::spawn(async move {
+        worker
+            .run(
+                SyncConfig {
+                    poll_interval_secs: 600,
+                    reconcile_interval_secs: 900,
+                    ..Default::default()
+                },
+                Some(trigger_rx),
+            )
+            .await;
+    });
+    let result = tokio::time::timeout(Duration::from_secs(40), async {
+        loop {
+            let event = progress_rx.recv().await.expect("worker must keep running");
+            if event.phase == "initial" && event.status == "completed" {
+                break;
+            }
+            assert_ne!(event.status, "error", "fixture startup must succeed");
+        }
+        server.fail_next_selects(2);
+        trigger_tx.send(SyncTrigger::Manual).unwrap();
+        let mut failed = false;
+        loop {
+            let event = progress_rx.recv().await.expect("worker must recover");
+            if event.phase == "reconcile" && event.status == "error" {
+                failed = true;
+            }
+            if event.phase == "reconcile" && event.status == "completed" {
+                assert!(failed, "recovery must follow the full-pass failure");
+                break;
+            }
+        }
+    })
+    .await;
+    let _ = stop_tx.send(true);
+    task.abort();
+    let _ = task.await;
+    assert!(
+        result.is_ok(),
+        "manual failure must retry within backoff, not after 15 minutes"
+    );
+    assert_eq!(server.command_count("INJECTED_BYE"), 2);
+}
