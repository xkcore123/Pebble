+async fn lookup_message_id(
+    sess: &mut ImapSession,
+    mailbox: &str,
+    header: &str,
+) -> Result<Option<u32>> {
+    use async_imap::error::Error;
+    use async_imap::imap_proto::{AttributeValue, MessageSection, Response, SectionPath};
+    if header.contains(['\r', '\n', '\0']) {
+        return Err(PebbleError::Validation("Invalid Message-ID".into()));
+    }
+    with_imap_timeout("SELECT", IMAP_COMMAND_TIMEOUT_SECS, sess.select(mailbox)).await?;
+    let criteria = format!(
+        "HEADER \"Message-ID\" \"{}\"",
+        header.replace('\\', "\\\\").replace('"', "\\\"")
+    );
+    let mut candidates = match checked_uid_search(sess, &criteria).await {
+        Ok(ids) => ids,
+        Err(Error::No(_) | Error::Bad(_)) => checked_uid_search(sess, "ALL")
+            .await
+            .map_err(|e| PebbleError::Network(format!("UID SEARCH ALL failed: {e}")))?,
+        Err(e) => return Err(PebbleError::Network(format!("UID SEARCH failed: {e}"))),
+    };
+    candidates.sort_unstable();
+    candidates.dedup();
+    let expected = header.trim();
+    let expected = expected
+        .strip_prefix('<')
+        .and_then(|s| s.strip_suffix('>'))
+        .unwrap_or(expected);
+    let mut found = None;
+    for batch in candidates.chunks(64) {
+        let ids = batch
+            .iter()
+            .map(u32::to_string)
+            .collect::<Vec<_>>()
+            .join(",");
+        let mut seen = HashSet::new();
+        let mut ambiguous = false;
+        identity_command(
+            sess,
+            &format!("UID FETCH {ids} (UID BODY.PEEK[HEADER.FIELDS (MESSAGE-ID)])"),
+            |response| {
+                if let Response::Fetch(_, attrs) = response {
+                    let uid = attrs.iter().find_map(|a| match a {
+                        AttributeValue::Uid(id) => Some(*id),
+                        _ => None,
+                    });
+                    let raw = attrs.iter().find_map(|a| match a {
+                        AttributeValue::BodySection {
+                            section: Some(SectionPath::Full(MessageSection::Header)),
+                            index: None,
+                            data: Some(raw),
+                        } => Some(raw.as_ref()),
+                        _ => None,
+                    });
+                    if let (Some(uid), Some(raw)) = (uid, raw) {
+                        if batch.binary_search(&uid).is_ok() && seen.insert(uid) {
+                            let parsed = mail_parser::MessageParser::default().parse(raw);
+                            if parsed.as_ref().and_then(|m| m.message_id()) == Some(expected)
+                                && found.replace(uid).is_some()
+                            {
+                                ambiguous = true;
+                            }
+                        }
+                    }
+                }
+            },
