diff --git a/crates/pebble-mail/src/test_imap.rs b/crates/pebble-mail/src/test_imap.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0ebf77d2690b8653e24578d2bba1f0c4088d36c8
--- /dev/null
+++ b/crates/pebble-mail/src/test_imap.rs
@@ -0,0 +1,258 @@
+// Local, credential-free IMAP fixtures for connection and deletion regressions.
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::net::TcpListener;
+use tokio::task::{JoinHandle, JoinSet};
+
+use super::imap::{ConnectionSecurity, ImapConfig};
+
+#[derive(Clone, Copy)]
+pub(crate) enum Behavior {
+    SelectDenied,
+    MissingInbox,
+    ByeThenEmpty,
+    ByeThenDenied,
+    ByeTwiceThenEmpty,
+    ArmedBye,
+    RejectIdle,
+    NestedMailbox,
+    SilentDone,
+    SilentLogout,
+    DropFirstLogin,
+    RejectLogin,
+    TrashMailbox,
+    SearchDenied,
+    SearchBad,
+    SearchDropped,
+    EmptySearch,
+    HeaderSearchDenied,
+    HeaderFetchDenied,
+    DuplicateHeader,
+    NoTrash,
+    ListDenied,
+    PartialListDenied,
+    SilentList,
+    SilentListCollect,
+}
+
+fn take_select_failure(counter: &AtomicUsize) -> bool {
+    let mut current = counter.load(Ordering::SeqCst);
+    while current > 0 {
+        match counter.compare_exchange_weak(
+            current,
+            current - 1,
+            Ordering::SeqCst,
+            Ordering::SeqCst,
+        ) {
+            Ok(_) => return true,
+            Err(value) => current = value,
+        }
+    }
+    false
+}
+
+pub(crate) struct Server {
+    port: u16,
+    commands: Arc<Mutex<Vec<String>>>,
+    task: JoinHandle<()>,
+    select_failures: Arc<AtomicUsize>,
+}
+
+impl Drop for Server {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+impl Server {
+    pub(crate) async fn start(behavior: Behavior) -> Self {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let commands = Arc::new(Mutex::new(Vec::new()));
+        let recorded = Arc::clone(&commands);
+        let select_failures = Arc::new(AtomicUsize::new(0));
+        let control = Arc::clone(&select_failures);
+        let task = tokio::spawn(async move {
+            let mut clients = JoinSet::new();
+            let mut connection = 0;
+            loop {
+                let (socket, _) = listener.accept().await.unwrap();
+                let index = connection;
+                connection += 1;
+                let recorded = Arc::clone(&recorded);
+                let select_failures = Arc::clone(&select_failures);
+                clients.spawn(async move {
+                    let mut stream = BufReader::new(socket);
+                    stream.get_mut().write_all(b"* OK Test IMAP ready\r\n").await.unwrap();
+                    let mut idle_tag = String::new();
+                    let mut selected = String::new();
+                    let mut moved = false;
+                    loop {
+                        let mut line = String::new();
+                        if stream.read_line(&mut line).await.unwrap_or(0) == 0 {
+                            break;
+                        }
+                        let mut words = line.split_whitespace();
+                        let tag = words.next().unwrap().to_string();
+                        let command = words.next().unwrap_or("").to_ascii_uppercase();
+                        // Never record LOGIN arguments, even in test fixtures.
+                        recorded.lock().unwrap().push(command.clone());
+                        let reply = if tag == "DONE" {
+                            if matches!(behavior, Behavior::SilentDone) {
+                                std::future::pending::<()>().await;
+                            }
+                            format!("{idle_tag} OK IDLE completed\r\n")
+                        } else if command == "LOGIN" {
+                            if matches!(behavior, Behavior::DropFirstLogin) && index == 0 {
+                                break;
+                            }
+                            if matches!(behavior, Behavior::RejectLogin) {
+                                stream.get_mut().write_all(format!("{tag} NO Invalid credentials\r\n").as_bytes()).await.unwrap();
+                                break;
+                            }
+                            format!("{tag} OK LOGIN completed\r\n")
+                        } else if command == "LIST" {
+                            match behavior {
+                                Behavior::SilentList => std::future::pending::<String>().await,
+                                Behavior::SilentListCollect => {
+                                    stream.get_mut().write_all(b"* LIST () \"/\" \"INBOX\"\r\n").await.unwrap();
+                                    std::future::pending::<String>().await
+                                }
+                                Behavior::PartialListDenied => format!("* LIST (\\Trash) \"/\" \"Trash\"\r\n{tag} NO LIST denied\r\n"),
+                                Behavior::ListDenied => format!("{tag} NO LIST denied\r\n"),
+                                Behavior::TrashMailbox | Behavior::HeaderSearchDenied | Behavior::HeaderFetchDenied | Behavior::DuplicateHeader => format!("* LIST () \"/\" \"INBOX\"\r\n* LIST (\\HasNoChildren) \"/\" \"&XfJSIJZk-\"\r\n{tag} OK LIST completed\r\n"),
+                                Behavior::NestedMailbox => format!("* LIST () \"/\" \"INBOX\"\r\n* LIST (\\HasNoChildren) \"/\" \"Projects/Work\"\r\n* LIST (\\All) \"/\" \"All Mail\"\r\n{tag} OK LIST completed\r\n"),
+                                _ => format!("* LIST () \"/\" \"INBOX\"\r\n{tag} OK LIST completed\r\n"),
+                            }
+                        } else if command == "SELECT" {
+                            selected = words.next().unwrap_or("").trim_matches('"').to_string();
+                            match behavior {
+                                Behavior::ArmedBye if take_select_failure(&select_failures) => {
+                                    recorded.lock().unwrap().push("INJECTED_BYE".into());
+                                    stream.get_mut().write_all(b"* BYE injected connection reset\r\n").await.unwrap();
+                                    break;
+                                }
+                                Behavior::ByeTwiceThenEmpty if select_failures.fetch_add(1, Ordering::SeqCst) < 2 => {
+                                    recorded.lock().unwrap().push("INJECTED_BYE".into());
+                                    stream.get_mut().write_all(b"* BYE problems with connection\r\n").await.unwrap();
+                                    break;
+                                }
+                                Behavior::ByeThenEmpty | Behavior::ByeThenDenied if index == 0 => {
+                                    stream.get_mut().write_all(b"* BYE problems with connection\r\n").await.unwrap();
+                                    break;
+                                }
+                                Behavior::SelectDenied | Behavior::ByeThenDenied => {
+                                    format!("{tag} NO [NOPERM] Permission denied\r\n")
+                                }
+                                Behavior::MissingInbox => format!("{tag} NO SELECT Folder not exist\r\n"),
+                                // Exercise SEARCH failure, not the valid zero-EXISTS fast path.
+                                Behavior::SearchDenied | Behavior::SearchBad | Behavior::SearchDropped =>
+                                    format!("* FLAGS (\\Seen)\r\n* 1 EXISTS\r\n* OK [UIDVALIDITY 42] UIDs valid\r\n* OK [UIDNEXT 8] Next UID\r\n{tag} OK SELECT completed\r\n"),
+                                _ => format!("* FLAGS (\\Seen)\r\n* 0 EXISTS\r\n* OK [UIDVALIDITY 42] UIDs valid\r\n* OK [UIDNEXT 1] Next UID\r\n{tag} OK [READ-WRITE] SELECT completed\r\n"),
+                            }
+                        } else if command == "UID" {
+                            match words.next().unwrap_or("").to_ascii_uppercase().as_str() {
+                                "SEARCH" => {
+                                    recorded.lock().unwrap().push("UID SEARCH".into());
+                                    let uid = if selected == "&XfJSIJZk-" && moved {
+                                        " 42"
+                                    } else if selected == "INBOX" && !moved {
+                                        " 7"
+                                    } else { "" };
+                                    if matches!(behavior, Behavior::SearchDropped) {
+                                        stream.get_mut().write_all(b"* SEARCH 7\r\n").await.unwrap();
+                                        break;
+                                    }
+                                    if matches!(behavior, Behavior::SearchDenied) {
+                                        format!("* SEARCH\r\n{tag} NO [UNAVAILABLE] backend error\r\n")
+                                    } else if matches!(behavior, Behavior::SearchBad) {
+                                        format!("* SEARCH 7\r\n{tag} BAD unsupported search\r\n")
+                                    } else if matches!(behavior, Behavior::EmptySearch) {
+                                        format!("* SEARCH\r\n{tag} OK empty mailbox\r\n")
+                                    } else if matches!(behavior, Behavior::HeaderSearchDenied | Behavior::HeaderFetchDenied | Behavior::DuplicateHeader)
+                                        && words.next().is_some_and(|word| word.eq_ignore_ascii_case("HEADER")) {
+                                        format!("* SEARCH 999\r\n{tag} NO [UNAVAILABLE] search backend error\r\n")
+                                    } else if matches!(behavior, Behavior::DuplicateHeader) {
+                                        format!("* SEARCH 7 8\r\n{tag} OK search completed\r\n")
+                                    } else {
+                                        format!("* SEARCH{uid}\r\n{tag} OK SEARCH completed\r\n")
+                                    }
+                                }
+                                "FETCH" => {
+                                    let ids = words.next().unwrap_or("");
+                                    let header = "Message-ID: <fixture@example.invalid>\r\n\r\n";
+                                    let mut data = String::new();
+                                    for (index, uid) in ids.split(',').enumerate() {
+                                        data.push_str(&format!("* {} FETCH (UID {uid} BODY[HEADER.FIELDS (MESSAGE-ID)] {{{}}}\r\n{header})\r\n", index+1, header.len()));
+                                    }
+                                    let status = if matches!(behavior, Behavior::HeaderFetchDenied) { "NO" } else { "OK" };
+                                    format!("{data}{tag} {status} header fetch\r\n")
+                                }
+                                "MOVE" => {
+                                    recorded.lock().unwrap().push("UID MOVE".into());
+                                    moved = true;
+                                    format!("{tag} OK MOVE completed\r\n")
+                                }
+                                _ => format!("{tag} OK completed\r\n"),
+                            }
+                        } else if command == "IDLE" {
+                            if matches!(behavior, Behavior::RejectIdle) {
+                                stream.get_mut().write_all(format!("{tag} BAD IDLE unavailable\r\n").as_bytes()).await.unwrap();
+                                break;
+                            }
+                            idle_tag = tag;
+                            "+ idling\r\n".to_string()
+                        } else if command == "LOGOUT" {
+                            if matches!(behavior, Behavior::SilentLogout) {
+                                std::future::pending::<()>().await;
+                            }
+                            format!("* BYE logging out\r\n{tag} OK LOGOUT completed\r\n")
+                        } else {
+                            format!("{tag} OK completed\r\n")
+                        };
+                        if stream.get_mut().write_all(reply.as_bytes()).await.is_err() {
+                            break;
+                        }
+                    }
+                });
+            }
+        });
+        Self {
+            port,
+            commands,
+            task,
+            select_failures: control,
+        }
+    }
+
+    pub(crate) fn config(&self) -> ImapConfig {
+        ImapConfig {
+            host: "127.0.0.1".to_string(),
+            port: self.port,
+            username: "fixture-user".to_string(),
+            password: "fixture-password".to_string(),
+            security: ConnectionSecurity::Plain,
+            accept_invalid_certs: false,
+            proxy: None,
+        }
+    }
+
+    pub(crate) fn login_count(&self) -> usize {
+        self.command_count("LOGIN")
+    }
+
+    pub(crate) fn fail_next_selects(&self, count: usize) {
+        self.select_failures.store(count, Ordering::SeqCst);
+    }
+
+    pub(crate) fn command_count(&self, command: &str) -> usize {
+        self.commands
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|cmd| cmd.as_str() == command)
+            .count()
+    }
+}
